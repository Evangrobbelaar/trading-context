//@version=6
// ═══════════════════════════════════════════════════════════════════════
// SMC v1 — Session Momentum Continuation
// Built 23 Jul 2026 as the proposed replacement for the Sprung Ladder.
//
// DESIGN INTENT — read this before changing anything:
//   The Sprung Ladder failed on THIS system for a structural reason, not a
//   market one: it needs a reclaim inside 15 minutes, and the tick loop has a
//   39-minute MEAN gap (measured 22 Jul: median 8, mean 39, max 248, 36% of
//   gaps >15min). A third of its trigger windows opened and shut between ticks.
//
//   SMC fixes that by firing on ZONE ESTABLISHMENT, not on price arrival.
//   The alert carries entry/SL/TP so the executor can place a RESTING LIMIT
//   order and let the broker fill it. Latency stops mattering entirely.
//
//   It also trades WITH the higher-timeframe trend rather than fading extremes,
//   which is the side of the trade with an actual evidence base
//   (Moskowitz/Ooi/Pedersen 2012; Gao/Han/Li/Zhou 2018).
//
// ALERT SETUP: create the alert with condition "Any alert() function call",
// webhook to the VPS receiver. One alert per symbol per timeframe. 30m or H1.
// ═══════════════════════════════════════════════════════════════════════
indicator("SMC v1 — Session Momentum Continuation", overlay = true,
     max_lines_count = 100, max_labels_count = 100, max_boxes_count = 100)

// ─── Inputs ────────────────────────────────────────────────────────────
gT = "Trend filter"
htf       = input.timeframe("240", "Trend timeframe",        group = gT)
trendLen  = input.int(50,          "Trend EMA length",       group = gT, minval = 5)

gL = "Impulse leg"
pivLen    = input.int(5,     "Pivot lookback",              group = gL, minval = 2)
retMin    = input.float(0.382, "Zone start (retrace)",      group = gL, step = 0.01)
retMax    = input.float(0.618, "Zone end (retrace)",        group = gL, step = 0.01)
minLegATR = input.float(1.5, "Min leg size (x ATR)",        group = gL, step = 0.1)

gR = "Risk"
atrLen    = input.int(14,     "ATR length",                 group = gR, minval = 2)
slBuffATR = input.float(0.5,  "SL buffer (x ATR)",          group = gR, step = 0.1)
rrTarget  = input.float(2.0,  "Target R:R",                 group = gR, step = 0.1)

gF = "Quality filters"
volLen    = input.int(20,     "Volume MA length",           group = gF, minval = 2)
volMin    = input.float(1.2,  "Min volume multiple",        group = gF, step = 0.1)
atrPctMin = input.float(0.40, "Min ATR percentile (0-1)",   group = gF, step = 0.05)
useVol    = input.bool(false, "Require volume confirm (off for FX)", group = gF)

gS = "Session"
skipAsia  = input.bool(true,  "Skip 00:00-07:00 SAST",      group = gS)

// ─── Core series ───────────────────────────────────────────────────────
atr = ta.atr(atrLen)

htfClose = request.security(syminfo.tickerid, htf, close,
     lookahead = barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, trendLen),
     lookahead = barmerge.lookahead_off)
htfUp    = request.security(syminfo.tickerid, htf, ta.rising(ta.ema(close, trendLen), 2),
     lookahead = barmerge.lookahead_off)
htfDn    = request.security(syminfo.tickerid, htf, ta.falling(ta.ema(close, trendLen), 2),
     lookahead = barmerge.lookahead_off)

// Trend requires BOTH price on the right side of the EMA and the EMA sloping.
// Price-only would flag every chop bar that pokes across.
trendUp = htfClose > htfEma and htfUp
trendDn = htfClose < htfEma and htfDn

// ─── Impulse leg via pivots ────────────────────────────────────────────
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

var float lastPH    = na
var float lastPL    = na
var int   lastPHbar = na
var int   lastPLbar = na

if not na(ph)
    lastPH    := ph
    lastPHbar := bar_index - pivLen
if not na(pl)
    lastPL    := pl
    lastPLbar := bar_index - pivLen

havePivots = not na(lastPH) and not na(lastPL)
legUp = havePivots and lastPHbar > lastPLbar        // low then high = up leg
legDn = havePivots and lastPLbar > lastPHbar        // high then low = down leg
legRange  = havePivots ? math.abs(lastPH - lastPL) : na
legBigEnough = not na(legRange) and legRange > minLegATR * atr

// ─── Retracement zones, entry, stop, target ────────────────────────────
// Long: pull back DOWN into the zone measured from the swing high.
zoneHiL = legUp ? lastPH - retMin * legRange : na
zoneLoL = legUp ? lastPH - retMax * legRange : na
entryL  = legUp ? (zoneHiL + zoneLoL) / 2       : na
slL     = legUp ? lastPL - slBuffATR * atr      : na
tpL     = legUp ? entryL + rrTarget * (entryL - slL) : na

// Short: pull back UP into the zone measured from the swing low.
zoneLoS = legDn ? lastPL + retMin * legRange : na
zoneHiS = legDn ? lastPL + retMax * legRange : na
entryS  = legDn ? (zoneHiS + zoneLoS) / 2       : na
slS     = legDn ? lastPH + slBuffATR * atr      : na
tpS     = legDn ? entryS - rrTarget * (slS - entryS) : na

// ─── Quality filters ───────────────────────────────────────────────────
volMa  = ta.sma(volume, volLen)
volOk  = not useVol or na(volume) or volume > volMin * volMa
atrPct = ta.percentrank(atr, 100) / 100
atrOk  = atrPct >= atrPctMin

// SAST = UTC+2. Asian window is structurally dead for FX majors under the
// Rule15 doubled-SL floor (measured 23 Jul: 11 ticks, 0 setups could clear
// the arithmetic — required 36-60 pips reward, available 1.3-12).
hourSAST = (hour(time, "UTC") + 2) % 24
sessOk   = not skipAsia or (hourSAST >= 7 and hourSAST < 24)

// Price must still be ABOVE the long zone (not yet pulled back) so the
// resting limit has somewhere to fill from. Same logic inverted for shorts.
roomL = legUp and close > zoneHiL
roomS = legDn and close < zoneLoS

validL = legUp and legBigEnough and trendUp and atrOk and volOk and sessOk and roomL and slL < entryL
validS = legDn and legBigEnough and trendDn and atrOk and volOk and sessOk and roomS and slS > entryS

// ─── Fire once per leg, not once per bar ───────────────────────────────
var int firedPHbar = na
var int firedPLbar = na

newL = validL and (na(firedPHbar) or firedPHbar != lastPHbar)
newS = validS and (na(firedPLbar) or firedPLbar != lastPLbar)

f(x) => str.tostring(x, format.mintick)

if newL and barstate.isconfirmed
    firedPHbar := lastPHbar
    alert('{"strategy":"SMC","v":"1.0","event":"ZONE_LONG"' +
       ',"symbol":"'    + syminfo.ticker    + '"' +
       ',"tickerid":"'  + syminfo.tickerid  + '"' +
       ',"exchange":"'  + syminfo.prefix    + '"' +
       ',"tf":"'        + timeframe.period  + '"' +
       ',"entry":'      + f(entryL)  +
       ',"sl":'         + f(slL)     +
       ',"tp":'         + f(tpL)     +
       ',"zone_hi":'    + f(zoneHiL) +
       ',"zone_lo":'    + f(zoneLoL) +
       ',"swing_hi":'   + f(lastPH)  +
       ',"swing_lo":'   + f(lastPL)  +
       ',"last":'       + f(close)   +
       ',"rr":'         + str.tostring(rrTarget, "#.##") +
       ',"atr":'        + f(atr) +
       ',"leg_atr":'    + str.tostring(legRange / atr, "#.##") +
       ',"atr_pct":'    + str.tostring(atrPct, "#.##") +
       ',"htf_trend":"UP","htf":"' + htf + '"' +
       ',"t":'          + str.tostring(timenow) + '}',
       alert.freq_once_per_bar_close)

if newS and barstate.isconfirmed
    firedPLbar := lastPLbar
    alert('{"strategy":"SMC","v":"1.0","event":"ZONE_SHORT"' +
       ',"symbol":"'    + syminfo.ticker    + '"' +
       ',"tickerid":"'  + syminfo.tickerid  + '"' +
       ',"exchange":"'  + syminfo.prefix    + '"' +
       ',"tf":"'        + timeframe.period  + '"' +
       ',"entry":'      + f(entryS)  +
       ',"sl":'         + f(slS)     +
       ',"tp":'         + f(tpS)     +
       ',"zone_hi":'    + f(zoneHiS) +
       ',"zone_lo":'    + f(zoneLoS) +
       ',"swing_hi":'   + f(lastPH)  +
       ',"swing_lo":'   + f(lastPL)  +
       ',"last":'       + f(close)   +
       ',"rr":'         + str.tostring(rrTarget, "#.##") +
       ',"atr":'        + f(atr) +
       ',"leg_atr":'    + str.tostring(legRange / atr, "#.##") +
       ',"atr_pct":'    + str.tostring(atrPct, "#.##") +
       ',"htf_trend":"DOWN","htf":"' + htf + '"' +
       ',"t":'          + str.tostring(timenow) + '}',
       alert.freq_once_per_bar_close)

// ─── Plots ─────────────────────────────────────────────────────────────
plot(htfEma, "HTF trend EMA", color = trendUp ? color.new(color.teal, 0)
     : trendDn ? color.new(color.maroon, 0) : color.new(color.gray, 50), linewidth = 2)

bgcolor(trendUp ? color.new(color.teal, 94) : trendDn ? color.new(color.maroon, 94) : na)

var box zbL = na
var box zbS = na
if newL and barstate.isconfirmed
    zbL := box.new(bar_index, zoneHiL, bar_index + 20, zoneLoL,
         border_color = color.teal, bgcolor = color.new(color.teal, 85))
if newS and barstate.isconfirmed
    zbS := box.new(bar_index, zoneHiS, bar_index + 20, zoneLoS,
         border_color = color.maroon, bgcolor = color.new(color.maroon, 85))

plotshape(newL and barstate.isconfirmed, "Long zone", shape.triangleup,
     location.belowbar, color.teal, size = size.small)
plotshape(newS and barstate.isconfirmed, "Short zone", shape.triangledown,
     location.abovebar, color.maroon, size = size.small)
