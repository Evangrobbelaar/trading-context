[Unit]
Description=TradingView webhook receiver (tv-pipeline)
After=network.target

[Service]
WorkingDirectory=/root/trading-context/tv-pipeline/receiver
Environment=TV_KEY=CHANGE_ME
Environment=TV_REPO_DIR=/root/trading-context
Environment=TV_AUTO_GIT=1
ExecStart=/usr/bin/python3 -m uvicorn tv_receiver:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
